# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_WEBHOOK_SECRET="MY_TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_ALLOWED_USER_ID="12345678,87654321"

# Firestore configuration (optional if firebase-applet-config.json is present)
FIRESTORE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
PORT=3000

# Firebase Admin Service Account Key (One of the following):
# Option A: Path to service-account.json file
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
# Option B: Raw JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_KEY=""
